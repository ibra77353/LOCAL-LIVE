# البرنس لايف — مُولّد تلقائياً من لوحة التحكم (مُهيّأ لـ200+ مشاهد)
# سجلّ أخطاء بمسار مطلق ثابت: نقرأه من كود Node لتشخيص فشل الربط بالمنفذ
# (مثل حظر ويندوز/Hyper-V لنطاق منافذ) بدل ترك المستخدم أمام فشل صامت.
error_log "H:/Appli/AmaanLive-Windows/nginx/logs/error.log" warn;
worker_processes  auto;
worker_rlimit_nofile 16384;
# حاسم لويندوز: عند quit/reload يبقى العامل القديم "قيد الانسحاب" ما دامت لديه
# اتصالات keep-alive حية (65ث تتجدد!) — فتتراكم عمليات nginx.exe عالقة مع كل
# إعادة تشغيل. هذه المهلة تفرض إنهاء العامل المنسحب خلال 10 ثوانٍ مهما كان.
worker_shutdown_timeout 10s;
events {
    worker_connections 8192;
    multi_accept on;
}
http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    sendfile_max_chunk 512k;
    tcp_nopush    on;
    tcp_nodelay   on;
    gzip          off;
    keepalive_timeout 65;
    keepalive_requests 10000;
    reset_timedout_connection on;
    # ذاكرة وصف الملفات: تُسرّع خدمة آلاف مقاطع .ts المتغيّرة باستمرار
    open_file_cache max=8000 inactive=30s;
    open_file_cache_valid 10s;
    open_file_cache_min_uses 1;
    open_file_cache_errors off;
    types {
        application/vnd.apple.mpegurl m3u8;
        video/mp2t ts;
    }
    server {
        listen 80 reuseport;
        server_name _;

        # قوائم m3u8 تمرّ عبر Node (خفيفة جداً) لا تُخدَم من القرص مباشرةً: هذا هو
        # مسار heartbeat/noteHlsAccess الذي يمنع إيقاف الخمول لقناة يشاهدها أحد عبر
        # رابط HLS مباشر (VLC/تلفاز) بلا heartbeat من صفحة المشاهد. لو خدمناها من
        # nginx مباشرةً (كما كان) لن يصل Node أي طلب لتلك القناة فتُوقَف كأنها بلا
        # مشاهدين رغم مشاهدتها فعلياً. القوائم صغيرة الحجم فتمريرها لا يكلّف الأداء.
        location ~ ^/hls/.+\.m3u8$ {
            proxy_pass http://127.0.0.1:3001;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
        # يخدم مقاطع .ts فقط (قوائم m3u8 مُحوّلة إلى Node عبر الموقع أعلاه).
        # حاسم: لا نضع location متداخلاً تحت alias — nginx لا يورّث الـalias للمواقع
        # المتداخلة، فيُخدَم .ts من الجذر الافتراضي (html/) بدل مجلد HLS → 404 لكل
        # المقاطع. هذا بالضبط سبب "يعمل على منفذ Node مباشرةً 3001 لكنه يفشل عبر
        # nginx". المقطع ثابت باسم فريد بعد كتابته، فالكاش الطويل immutable يوضَع
        # مباشرةً على هذا الموقع دون تداخل.
        location /hls/ {
            alias "H:/Appli/AmaanLive-Windows/srv/hls/";
            access_log off;                       # 200+ مشاهد × مقاطع كثيرة = سجل ضخم بلا فائدة
            add_header Access-Control-Allow-Origin *;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
        location /uploads/ {
            alias "H:/Appli/AmaanLive-Windows/srv/uploads/";
            access_log off;
            add_header Cache-Control "max-age=3600";
        }
        location / {
            proxy_pass http://127.0.0.1:3001;
            proxy_http_version 1.1;
            proxy_set_header Connection "";       # keep-alive نحو Node لتقليل كلفة الاتصالات
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 300;
            client_max_body_size 2048m;
        }
    }
}
